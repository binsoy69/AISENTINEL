[Desktop Entry]
Type=Application
Name=AISENTINEL Calibrate Front Webcam
Comment=Create or update the front node webcam setup profile
Exec=sh -c "desktop_file=\"$1\"; repo_root=\"$(cd \"$(dirname \"$(readlink -f \"$desktop_file\")\")/../..\" && pwd)\"; cd \"$repo_root\" && AISENTINEL_KEEP_TERMINAL=1 bash programs/pi/calibrate_front_webcam.sh" sh %k
Terminal=true
Categories=Utility;
