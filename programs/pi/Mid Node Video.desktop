[Desktop Entry]
Type=Application
Name=AISENTINEL Mid Node Video
Comment=Run the mid node with its configured video source
Exec=sh -c "desktop_file=\"$1\"; repo_root=\"$(cd \"$(dirname \"$(readlink -f \"$desktop_file\")\")/../..\" && pwd)\"; cd \"$repo_root\" && AISENTINEL_KEEP_TERMINAL=1 bash programs/pi/run_mid_node_video.sh" sh %k
Terminal=true
Categories=Utility;
