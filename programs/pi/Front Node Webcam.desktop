[Desktop Entry]
Type=Application
Name=AISENTINEL Front Node Webcam
Comment=Run the front node with its configured webcam
Exec=sh -c "desktop_file=\"$1\"; repo_root=\"$(cd \"$(dirname \"$(readlink -f \"$desktop_file\")\")/../..\" && pwd)\"; cd \"$repo_root\" && AISENTINEL_KEEP_TERMINAL=1 bash programs/pi/run_front_node_webcam.sh" sh %k
Terminal=true
Categories=Utility;
