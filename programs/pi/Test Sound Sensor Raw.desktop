[Desktop Entry]
Type=Application
Name=AISENTINEL Test Sound Sensor Raw
Comment=Continuously show raw KY-037 ADS1015 readings
Exec=sh -c "desktop_file=\"$1\"; repo_root=\"$(cd \"$(dirname \"$(readlink -f \"$desktop_file\")\")/../..\" && pwd)\"; cd \"$repo_root\" && AISENTINEL_KEEP_TERMINAL=1 bash programs/pi/test_sound_sensor_raw.sh" sh %k
Terminal=true
Categories=Utility;
