[Desktop Entry]
Type=Application
Name=AISENTINEL Calibrate Front Sound
Comment=Create or update the front node KY-037 sound calibration
Exec=sh -c "desktop_file=\"$1\"; repo_root=\"$(cd \"$(dirname \"$(readlink -f \"$desktop_file\")\")/../..\" && pwd)\"; cd \"$repo_root\" && AISENTINEL_KEEP_TERMINAL=1 bash programs/pi/calibrate_front_sound_sensor.sh" sh %k
Terminal=true
Categories=Utility;
