[service]
; Bind address for the central dashboard service.
host = 0.0.0.0
port = 8090
db_path = runtime/central_dashboard/data/central_service/central.sqlite3
evidence_root = runtime/central_dashboard/data/central_service/evidence
node_offline_after_sec = 12
proxy_timeout_sec = 10
stream_timeout_sec = 12

[browser_auth]
username = admin
password = CHANGE_ME_DASHBOARD_PASSWORD
secret_key = CHANGE_ME_RANDOM_SECRET_KEY
session_ttl_minutes = 480

[node:front]
display_name = Front Node
camera_label = Front Camera
api_key = CHANGE_ME_FRONT_NODE_API_KEY

[node:mid]
display_name = Mid Node
camera_label = Mid Camera
api_key = CHANGE_ME_MID_NODE_API_KEY
