[agent]
node_id = front
display_name = Front Node
camera_label = Front Camera
profile = front
host = 0.0.0.0
port = 8091
api_key = CHANGE_ME_FRONT_NODE_API_KEY
central_base_url = http://CENTRAL_DASHBOARD_HOST_OR_IP:8090
registration_interval_sec = 10
heartbeat_interval_sec = 3
sync_interval_sec = 2
http_timeout_sec = 5
local_db_path = runtime/central_dashboard/data/node_front/queue.sqlite3

[capture]
; Launchers choose webcam or video mode without requiring a second INI.
source_mode = webcam
camera_index = 0
video_path =

[preview]
width = 960
fps = 10
jpeg_quality = 72

[detector]
mode = front_runtime
motion_threshold = 24.0
motion_min_area_ratio = 0.012
motion_cooldown_sec = 8.0
annotated_banner_ttl_sec = 4.0

[models]
pose = models/CHANGE_ME_POSE_MODEL.hef
hand = models/CHANGE_ME_HAND_MODEL.hef
object = models/CHANGE_ME_OBJECT_MODEL.hef

[inference]
pose_confidence = 0.70
object_confidence = 0.25

[runtime]
port = 8080

[web_dashboard]
username = admin
password = CHANGE_ME_LOCAL_NODE_DASHBOARD_PASSWORD
secret_key = CHANGE_ME_RANDOM_NODE_SECRET
session_ttl_minutes = 480

[video_source]
default_video = CHANGE_ME_VIDEO_FILE.mp4
default_setup_profile =
auto_use_saved_setup = true

[webcam_source]
camera_index = 0
camera_name = front_webcam
capture_width = 1280
capture_height = 720
capture_fps = 30.0
warmup_frames = 15
default_setup_profile = runtime/central_dashboard/data/node_front/setup_profiles/front_webcam_all_behavior_setup.json
auto_use_saved_setup = true

[outputs]
evidence_root = runtime/central_dashboard/data/node_front/evidence
setup_profile_dir = runtime/central_dashboard/data/node_front/setup_profiles

[tracking]
iou_threshold = 0.30
max_lost = 60

[head_behavior]
head_tilt_angle_deg = 30.0
head_turn_ratio = 0.18
shoulder_turn_angle_deg = 20.0
sustained_sec = 2.5
event_cooldown_sec = 10.0
keypoint_confidence = 0.30

[passing_papers]
event_cooldown_sec = 10.0
keypoint_confidence = 0.30
row_tolerance_px = 80
reference_bbox_height = 300.0
wrist_proximity_px = 160
min_interaction_sec = 0.03

[hands_under_table]
hand_confidence = 0.30
person_confidence = 0.50
hands_missing_sustain_sec = 3.0
event_cooldown_sec = 10.0
min_visible_hands = 2
hand_assoc_margin_px = 60
smooth_window_frames = 12
smooth_missing_ratio = 0.60
student_absent_reset_sec = 2.0
table_edge_near_px = 35
edge_disappear_arm_sec = 0.75

[object_detection]
person_confidence = 0.50
phone_confidence = 0.25
cheat_sheet_confidence = 0.30
event_cooldown_sec = 10.0
assoc_iou_thresh = 0.05

[evidence]
root = runtime/central_dashboard/data/node_front/evidence
pre_event_frames = 2
post_event_frames = 2
gif_frame_count = 5
gif_max_width = 640
gif_fps = 4

[spam_suppression]
duplicate_suppression_sec = 60.0
clear_required_sec = 3.0

[sound_sensor]
enabled = true
calibration_config = CHANGE_ME_SOUND_CALIBRATION.json
alert_threshold_db = 55.0
incident_cooldown_sec = 10.0
i2c_bus = 1
i2c_address = 0x48
adc_channel = 0
full_scale = 4.096
data_rate = 1600
sample_interval = 0.002
window_seconds = 1.0
